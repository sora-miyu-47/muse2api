# ==========================================
# MUSE2API 配置环境变量示例
# 复制为 .env 即可生效: cp .env.example .env
# ==========================================

# [必填/选填] 管理与 API 鉴权密钥（以 m2a_ 开头）。
# 若留空，程序首次启动时会自动生成一个高强度随机密钥并打印到控制台日志。
MUSE2API_KEY=m2a_your_secret_admin_key_here

# 服务监听地址与端口（Docker 容器内需设为 0.0.0.0）
MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610

# 外部公开访问地址（供下游客户端接入及管理页拼接使用，如 https://api.yourdomain.com）
# 留空时，管理页面将自动使用当前浏览器访问的主机与端口
MUSE2API_PUBLIC_BASE=

# Chromium 浏览器可执行文件路径
# Linux/Docker 通常为 /usr/bin/chromium 或 /usr/bin/chromium-browser
# Windows 本地运行可设为 Chrome 完整路径或留空自动查找
MUSE2API_CHROMIUM=/usr/bin/chromium

# CDP 远程调试通信端口
MUSE2API_CDP_PORT=19210

# 任务超时控制（单位：秒）
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_CHAT_TIMEOUT=300

# 最大并发生成任务数（支持随服务器资源自由调高，默认 2）
MUSE2API_CONCURRENCY=2

# 是否对后台禁用的账号执行自动保活（0=关闭，1=开启）
# 开启后已禁用账号仍会执行静默保活与会话续期，但不会被路由参与正常生成与对话
MUSE2API_KEEPALIVE_DISABLED_ACCOUNTS=0

# 参考图安全开关（默认安全；仅可信单用户部署才考虑显式设为 1）
# 1：允许 API 请求读取服务器本地文件路径
MUSE2API_REF_IMAGE_LOCAL_FILES=0
# 1：允许 API 请求下载内网/本机 URL；0 时逐跳检查并仅允许公网 IP
MUSE2API_REF_IMAGE_PRIVATE_FETCH=0

# 按 OpenAI `user` 字段定向路由对话（详见 CHAT_USERS.md）；0=忽略 user 字段，恢复无状态轮转
MUSE2API_CHAT_USER_ROUTING=1
# 首次出现的 user 自动绑定一个空闲账号（0=关闭，只接受管理接口里配置过的 user）
MUSE2API_CHAT_USER_AUTO_BIND=1
# 每个账号最多绑定一个 user（0=允许多个 user 共用账号，但各自仍是独立 muse 线程）
MUSE2API_CHAT_USER_EXCLUSIVE=1
# 目标账号繁忙时最多排队等待的秒数；超时返回 429，不会切换到其它账号（0=不排队）
MUSE2API_CHAT_USER_QUEUE_TIMEOUT=120

# ---------- 审批卡自动处理（详见 README「审批卡自动批准」）----------
# 小号会话里弹出的 Allow / Deny 审批卡由网关按规则处理：白名单放行、黑名单永不自动批、其他只记日志不批。
# 总闸门：1 = 允许开启（管理页「审批卡」页签还能再关）；0 = 完全不看守（默认）。
MUSE2API_AUTO_APPROVE=0
# 演练模式：1 = 强制演练（只记审计日志，一个按钮都不点）；0 或留空 = 由管理页决定（管理页默认演练）。
# 建议先保持演练，在管理页看审计日志确认白名单没放错，再在管理页关掉演练。
MUSE2API_AUTO_APPROVE_DRY_RUN=1
# 构建安装类白名单（uv / pip / npm / make / pytest / cargo / go）会执行项目或依赖自带的脚本，网关无法检查其内容。
# 0 = 强制关闭这一组；留空 = 允许（管理页还能再关）。
MUSE2API_AUTO_APPROVE_BUILD=
# 允许看守的账号（账号 id 或备注名，逗号分隔）；留空 = 全部账号。管理页还能逐个关闭。
MUSE2API_AUTO_APPROVE_ACCOUNTS=
# 信任主机：你自己的服务器（主机名或 IP，可带端口，逗号分隔，例如 1.2.3.4,my.example.com:8443）。
# 小号访问这些主机的网络卡片会被放行，但只放行 GET / HEAD，且必须读到详情字段。管理页还能再添加。
MUSE2API_AUTO_APPROVE_HOSTS=
# 全放行模式（管理页开关，默认关）：打开后不看白名单，除「付款 / 下单 / 绑卡」和「发送密码 / cookie / 密钥」外全部放行。
# 目标是信任主机时，发送凭据也放行。0 = 强制关闭；留空 = 由管理页决定。
MUSE2API_AUTO_APPROVE_ALL=
